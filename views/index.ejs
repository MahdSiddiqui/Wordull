            <div <% if(locals.colorData){ %> style="background-color: <%=colorData.sixthWordSecondLetter%>" <% } %> class="grid-item"><% if(locals.alphaData){ %><%=alphaData.sixthWordSecondAlpha%> %><% } %></div>
            <div <% if(locals.colorData){ %> style="background-color: <%=colorData.sixthWordThirdLetter%>" <% } %> class="grid-item"><% if(locals.alphaData){ %><%=alphaData.sixthWordThirdAlpha%> %><% } %></div>
