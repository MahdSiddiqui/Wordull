        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.fourthWordFifthLetter%>" <% } %> class="grid-item"></div>

        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.fifthWordFirstLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.fifthWordSecondLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.fifthWordThirdLetter%>" <% } %> class="grid-item"></div>
