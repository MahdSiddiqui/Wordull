<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/style.css">
    <title>Wordull</title>
</head>
<body>

    <h1> <% if(locals.finalStatement){ %> <%= finalStatement %> <% } else{ %> Guess the Word <% } %></h1>
    <p>Guesses Left: <% if(locals.guessesLeft){ %> <%=guessesLeft%> <% } %> </p>


    <form action="/submit" method="POST">
        <input type="text" name="userGuess" placeholder="guess">
        <input class="submit" type="submit" value="OK">
    </form>

    <div class="mainContainerOfGrid">
    <div class="grid-container">
  
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.firstWordFirstLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.firstWordSecondLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.firstWordThirdLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.firstWordFourthLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.firstWordFifthLetter%>" <% } %> class="grid-item"></div>

        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.secondWordFirstLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.secondWordSecondLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.secondWordThirdLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.secondWordFourthLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.secondWordFifthLetter%>" <% } %> class="grid-item"></div>

        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.thirdWordFirstLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.thirdWordSecondLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.thirdWordThirdLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.thirdWordFourthLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.thirdWordFifthLetter%>" <% } %> class="grid-item"></div>

        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.fourthWordFirstLetter%>" <% } %> class="grid-item"></div>
        <div <% if(locals.colorData){ %> style="background-color: <%=colorData.fourthWordSecondLetter%>" <% } %> class="grid-item"></div>
