<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/style.css">
    <title>Wordull</title>
</head>
<body>

    <h1> <% if(locals.finalStatement){ %> <%= finalStatement %> <% } else{ %> Guess the Word <% } %></h1>

    
    

