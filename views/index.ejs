    <div class="infoContainer">
        <div class="guessesLeftContainer">
            <p class="guessesLeft">Guesses Left: <% if(locals.guessesLeft){ %> <%=guessesLeft%> <% } %> </p>
        </div>
        <div class="formContainer">
            <form action="/submit" method="POST"> 
                <input class="guessI" type="text" name="userGuess" placeholder="guess"> <br>
                <input class="btnI" class="submit" type="submit" value="OK">
