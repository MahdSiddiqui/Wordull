            <div <% if(locals.colorData){ %> style="background-color: <%=colorData.thirdWordSecondLetter%>" <% } %> class="grid-item"><% if(locals.alphaData){ %><%=alphaData.thirdWordSecondAlpha%> %><% } %></div>
            <div <% if(locals.colorData){ %> style="background-color: <%=colorData.thirdWordThirdLetter%>" <% } %> class="grid-item"><% if(locals.alphaData){ %><%=alphaData.thirdWordThirdAlpha%> %><% } %></div>
            <div <% if(locals.colorData){ %> style="background-color: <%=colorData.thirdWordFourthLetter%>" <% } %> class="grid-item"><% if(locals.alphaData){ %><%=alphaData.thirdWordFourthAlpha%> %><% } %></div>
